# Bootstrap-конфиг на время ПЕРВОГО выпуска сертификата: только 80-й, без ssl_*
# (nginx не стартует с mmo.conf.template, пока сертификата нет).
# После certbot удалить/переименовать этот файл и вернуть mmo.conf.template — см. deploy/README.md.
server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / {
        return 200 'mmo bootstrap ok';
        add_header Content-Type text/plain;
    }
}
